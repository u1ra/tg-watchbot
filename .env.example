# tg-watchbot environment
# Create a bot with @BotFather, then put the token here.
TELEGRAM_BOT_TOKEN=

# Telegram numeric chat id that receives monitor notifications and user messages.
ADMIN_CHAT_ID=

LOG_LEVEL=INFO

# Web admin panel. Bind to localhost by default; use a reverse proxy / Cloudflare Tunnel if exposing it.
WEB_PANEL_ENABLED=true
WEB_PANEL_HOST=127.0.0.1
WEB_PANEL_PORT=8765
WEB_PANEL_USER=admin
WEB_PANEL_PASSWORD=change-me
WEB_PANEL_SESSION_SECRET=
WEB_PANEL_COOKIE_SECURE=

# Optional: user-session listener for TG groups where bot cannot be added.
TG_API_ID=
TG_API_HASH=
TG_API_SESSION=

# Optional: proxy for Telethon (MTProto) connections. Required for servers in China.
# Examples: socks5://127.0.0.1:1080, http://127.0.0.1:7890
TG_PROXY=

# Optional: two-stage verification for new private-chat users.
# Keep disabled until the public HTTPS Mini App URL and production Turnstile values are ready.
BOT_VERIFICATION_ENABLED=false
BOT_VERIFICATION_PUBLIC_BASE_URL=
BOT_VERIFICATION_INITDATA_MAX_AGE_SECONDS=300
BOT_VERIFICATION_SESSION_TTL_SECONDS=600
BOT_VERIFICATION_MATH_TTL_SECONDS=600
BOT_VERIFICATION_MATH_MAX_ATTEMPTS=3
BOT_VERIFICATION_COOLDOWN_SECONDS=600
BOT_VERIFICATION_PROMPT_INTERVAL_SECONDS=15

# Production uses the Turnstile sitekey and the HTTPS URL of the Spin siteverify Worker.
# The Turnstile secret belongs in that Worker, never in this file or repository.
TURNSTILE_SITE_KEY=
TURNSTILE_VERIFY_ENDPOINT=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=turnstile-spin-v1
TURNSTILE_TEST_MODE=false
